    {
      "label": "Start Backend",
      "type": "shell",
      "command": "cd ~/medical-robot-platform/backend/Server && dotnet run --urls http://localhost:5000",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "group": "web",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "cd ~/medical-robot-platform/frontend && npm run dev -- --host 0.0.0.0 --port 5174",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "group": "web",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Check ROS API Robots",
      "type": "shell",
      "command": "curl -s http://localhost:5050/api/hospital/robots | python3 -m json.tool",
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Check Robots API",
      "type": "shell",
      "command": "curl -s http://localhost:5000/api/robots | python3 -m json.tool",
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Connect Backend To WS Adapter",
      "type": "shell",
      "command": "curl -X POST http://localhost:5000/api/robots/connect -H 'Content-Type: application/json' -d '{\"url\":\"ws://localhost:9090\"}'",
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Confirm Hospital Robots",
      "type": "shell",
      "command": "curl -X POST http://localhost:5000/api/robots/confirm -H 'Content-Type: application/json' -d '{\"rosName\":\"hospital_robot_1\",\"displayName\":\"機器人 A\"}'; echo; curl -X POST http://localhost:5000/api/robots/confirm -H 'Content-Type: application/json' -d '{\"rosName\":\"hospital_robot_2\",\"displayName\":\"機器人 B\"}'; echo",
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Start Gazebo Hospital World",
      "type": "shell",
      "command": "cd ~/clinical-multi-robot-collaboration-platform-system && export GZ_SIM_RESOURCE_PATH=$PWD/ros2_ws/src/my_hospital_rmf/models:$GZ_SIM_RESOURCE_PATH && gz sim ros2_ws/src/my_hospital_rmf/maps/hospital.world",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "group": "rmf",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Generate Gazebo Hospital Map",
      "type": "shell",
      "command": "cd ~/clinical-multi-robot-collaboration-platform-system && source /opt/ros/jazzy/setup.bash && source ~/rmf_ws/install/setup.bash && ros2 run rmf_building_map_tools building_map_generator gazebo ros2_ws/src/my_hospital_rmf/maps/hospital.building.yaml ros2_ws/src/my_hospital_rmf/maps/hospital.world ros2_ws/src/my_hospital_rmf/models",
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "group": "rmf",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Rebuild Gazebo Hospital Scene",
      "type": "shell",
      "command": "cd ~/clinical-multi-robot-collaboration-platform-system && ./ros2_ws/src/my_hospital_rmf/tools/rebuild_gazebo_scene.sh",
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "group": "rmf",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    }
  ]
}