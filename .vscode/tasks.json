{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Clean RMF Processes",
      "type": "shell",
      "command": "pkill -f hospital_fake_robot_state_publisher.py || true; pkill -f hospital_rule_dispatcher.py || true; pkill -f hospital_ros_api_bridge.py || true; pkill -f hospital_rosbridge_ws_adapter.py || true; pkill -f rmf_demos_fleet_adapter || true; pkill -f 'ros2 launch my_hospital_rmf hospital.launch.xml' || true",
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Start RMF Web API Server",
      "type": "shell",
      "command": "cd ~/rmf-web/packages/api-server && source ~/rmf_demo_env.sh && export RMF_SERVER_USE_SIM_TIME=false && pnpm start",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "group": "rmf",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Start RMF Dashboard",
      "type": "shell",
      "command": "cd ~/rmf-web/packages/rmf-dashboard-framework && pnpm start:example examples/demo",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "group": "rmf",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Build Hospital RMF",
      "type": "shell",
      "command": "cd ~/clinical-multi-robot-collaboration-platform-system/ros2_ws && source /opt/ros/jazzy/setup.bash && source ~/rmf_ws/install/setup.bash && colcon build --symlink-install",
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Start Fake Robots",
      "type": "shell",
      "command": "source ~/rmf_demo_env.sh && source ~/rmf_ws/install/setup.bash && source ~/clinical-multi-robot-collaboration-platform-system/ros2_ws/install/setup.bash && python3 ~/clinical-multi-robot-collaboration-platform-system/ros2_ws/src/my_hospital_rmf/scripts/hospital_fake_robot_state_publisher.py",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "group": "rmf",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Start Hospital RMF Launch",
      "type": "shell",
      "command": "source ~/rmf_demo_env.sh && source ~/rmf_ws/install/setup.bash && source ~/clinical-multi-robot-collaboration-platform-system/ros2_ws/install/setup.bash && ros2 launch my_hospital_rmf hospital.launch.xml use_sim_time:=false server_uri:='http://localhost:8000/_internal'",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "group": "rmf",
        "reveal": "always",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "Start Rule Dispatcher",
      "type": "shell",
