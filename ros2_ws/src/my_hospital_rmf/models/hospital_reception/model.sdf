<?xml version="1.0"?>
<sdf version="1.7">
  <model name="hospital_reception">
    <static>true</static>

    <!-- 上橫條（加寬） -->
    <link name="top_bar">
      <pose>0 0 0.45 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>6.5 0.5 0.9</size></box></geometry>
        <material><ambient>0.88 0.84 0.76 1</ambient><diffuse>0.88 0.84 0.76 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><box><size>6.5 0.5 0.9</size></box></geometry>
      </collision>
    </link>

    <!-- 左側臂 -->
    <link name="left_arm">
      <pose>-3.0 1.86 0.45 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>0.5 3.72 0.9</size></box></geometry>
        <material><ambient>0.88 0.84 0.76 1</ambient><diffuse>0.88 0.84 0.76 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.5 3.72 0.9</size></box></geometry>
      </collision>
    </link>

    <!-- 右側臂 -->
    <link name="right_arm">
      <pose>3.0 1.86 0.45 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>0.5 3.72 0.9</size></box></geometry>
        <material><ambient>0.88 0.84 0.76 1</ambient><diffuse>0.88 0.84 0.76 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.5 3.72 0.9</size></box></geometry>
      </collision>
    </link>

    <!-- 圓角：左上 -->
    <link name="corner_tl">
      <pose>-3.25 -0.0 0.45 0 0 0</pose>
      <visual name="visual">
        <geometry><cylinder><radius>0.25</radius><length>0.9</length></cylinder></geometry>
        <material><ambient>0.88 0.84 0.76 1</ambient><diffuse>0.88 0.84 0.76 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.25</radius><length>0.9</length></cylinder></geometry>
      </collision>
    </link>

    <!-- 圓角：右上 -->
    <link name="corner_tr">
      <pose>3.25 -0.0 0.45 0 0 0</pose>
      <visual name="visual">
        <geometry><cylinder><radius>0.25</radius><length>0.9</length></cylinder></geometry>
        <material><ambient>0.88 0.84 0.76 1</ambient><diffuse>0.88 0.84 0.76 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.25</radius><length>0.9</length></cylinder></geometry>
      </collision>
    </link>

    <!-- 圓角：左下 -->
    <link name="corner_bl">
      <pose>-3.25 3.72 0.45 0 0 0</pose>
      <visual name="visual">
        <geometry><cylinder><radius>0.25</radius><length>0.9</length></cylinder></geometry>
        <material><ambient>0.88 0.84 0.76 1</ambient><diffuse>0.88 0.84 0.76 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.25</radius><length>0.9</length></cylinder></geometry>
