    </link>

    <!-- 圓角：右下 -->
    <link name="corner_br">
      <pose>3.25 3.72 0.45 0 0 0</pose>
      <visual name="visual">
        <geometry><cylinder><radius>0.25</radius><length>0.9</length></cylinder></geometry>
        <material><ambient>0.88 0.84 0.76 1</ambient><diffuse>0.88 0.84 0.76 1</diffuse></material>
      </visual>
