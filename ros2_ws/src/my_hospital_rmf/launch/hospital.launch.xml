<?xml version='1.0' ?>

<launch>
  <arg name="use_sim_time" default="false"/> 
  <arg name="server_uri" default=""/>

  <!-- RMF Traffic Schedule (路徑規劃核心) -->
  <node pkg="rmf_traffic_ros2" exec="rmf_traffic_schedule" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- RMF Blockade (碰撞協調) -->
  <node pkg="rmf_traffic_ros2" exec="rmf_traffic_blockade" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- Robot State Aggregator: 把 /robot_state 聚合成 /fleet_states -->
  <!-- <node pkg="rmf_fleet_adapter" exec="robot_state_aggregator" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="fleet_name" value="hospital_fleet"/>
    <param name="robot_prefix" value="hospital"/>
  </node> -->

  <!-- Hospital Fleet Manager -->
  <node pkg="rmf_demos_fleet_adapter"
        exec="fleet_manager"
        args="--config_file $(find-pkg-share my_hospital_rmf)/config/fleet_config.yaml --nav_graph $(find-pkg-share my_hospital_rmf)/nav_graphs/0.yaml"
        output="both">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- Hospital Fleet Adapter -->
  <group>
    <group if="$(var use_sim_time)">
      <node pkg="my_hospital_rmf"
            exec="hospital_fleet_adapter"
            args="-c $(find-pkg-share my_hospital_rmf)/config/fleet_config.yaml -n $(find-pkg-share my_hospital_rmf)/nav_graphs/0.yaml -sim"
            output="both">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="server_uri" value="$(var server_uri)"/>
      </node>
    </group>

    <group unless="$(var use_sim_time)">
      <node pkg="my_hospital_rmf"
            exec="hospital_fleet_adapter"
            args="-c $(find-pkg-share my_hospital_rmf)/config/fleet_config.yaml -n $(find-pkg-share my_hospital_rmf)/nav_graphs/0.yaml"
            output="both">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="server_uri" value="$(var server_uri)"/>
      </node>
    </group>
  </group>

  <!-- RMF Door Supervisor -->
  <node pkg="rmf_fleet_adapter"
        exec="door_supervisor"
        output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- 模擬門設備：回應 /door_requests 並發布 /door_states -->
  <node pkg="my_hospital_rmf"
        exec="hospital_fake_door_adapter"
        output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- 模擬機器人 -->
  <node pkg="my_hospital_rmf" exec="hospital_fake_robot_state_publisher" output="screen"/>

  <!-- WebSocket 推播 (:9090) -->
  <node pkg="my_hospital_rmf" exec="hospital_rosbridge_ws_adapter" output="screen"/>

  <!-- HTTP API Bridge (:5050) -->
  <node pkg="my_hospital_rmf" exec="hospital_ros_api_bridge" output="screen"/>

  <!-- 地圖發布 (nav2_map_server → /map topic) -->
  <node pkg="nav2_map_server" exec="map_server" name="map_server" output="screen">
    <param name="yaml_filename" value="$(find-pkg-share my_hospital_rmf)/maps/hospital_map.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- 讓 map_server 進入 active 狀態 -->
  <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager_map" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="autostart" value="true"/>
    <param name="node_names" value="['map_server']"/>
  </node>

  <!-- Rosbridge WebSocket Server (port 9091，供前端 roslib 連線) -->
  <node pkg="rosbridge_server" exec="rosbridge_websocket" name="rosbridge_websocket" output="screen">
    <param name="port" value="9091"/>
  </node>

</launch>
